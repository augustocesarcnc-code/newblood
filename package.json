{
  "name": "eclipse-blood-and-moon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node apps/server/src/main.ts",
    "demo": "node jogar.mjs --demo",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "build": "vite build --config apps/client/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "postinstall": "node scripts/generate-prisma.mjs"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "12.4.1"
    }
  }
}
