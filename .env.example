# Copy to .env only for local development. Never commit real credentials.
# Run: node --env-file=.env server.js
MP_ACCESS_TOKEN=
# Raw webhook signing secret from the Mercado Pago Webhooks configuration.
# This value must be available locally for HMAC; a proxy placeholder cannot sign.
MP_WEBHOOK_SECRET=
# Public HTTPS origin only, without paths, query strings or embedded credentials.
PUBLIC_BASE_URL=
# VIP de 30 dias: R$ 15,00 (1500 centavos).
MP_VIP_PRICE_CENTS=1500
# Keep test until sandbox verification is complete. live enables real checkout.
MP_MODE=test

# Password recovery: verified sender plus Resend API key in secure settings.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Prisma CLI; runtime uses BLOODMOON_DATA_DIR/eclipse.sqlite.
DATABASE_URL="file:../.data/eclipse.sqlite"
# Enable the admin seed only for local development.
ECLIPSE_DEV=0
